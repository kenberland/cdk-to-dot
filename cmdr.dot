digraph CmdrArchitecture {
    // Global settings
    graph [
        rankdir=LR
        compound=true
        fontname="Helvetica"
        fontsize=11
        bgcolor="BG"
        color="FG"
        fontcolor="FG"
        pad=0.4
        nodesep=0.5
        ranksep=0.8
        label=<
            <TABLE BORDER="0" CELLSPACING="8" CELLPADDING="4">
                <TR><TD ALIGN="CENTER">
                    <B><FONT POINT-SIZE="14">cmdr Infrastructure</FONT></B><BR/>
                    <FONT POINT-SIZE="9" COLOR="MUTED">Generated from cdk.out · AWS · us-east-1</FONT>
                </TD></TR>
            </TABLE>
        >
        labelloc=t
    ]

    node [
        fontname="Helvetica"
        fontsize=10
        style=filled
        color="BORDER"
        fontcolor="FG"
        fillcolor="BG"
    ]

    edge [
        fontname="Helvetica"
        fontsize=8
        fontcolor="SUBTLE"
        color="EDGE"
    ]

    // ── Internet ───────────────────────────────────
    internet [
        label=""
        image="CLOUD_IMAGE"
        imagescale=true
        fixedsize=true
        width=1.4
        height=0.9
        shape=none
        style=""
    ]

    // ── NAT Gateway ───────────────────────────────
    nat_gateway [
        label=<
            <TABLE BORDER="0" CELLSPACING="1" CELLPADDING="2">
                <TR><TD><B>NAT Gateway</B></TD></TR>
                <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">Public Subnet 1</FONT></TD></TR>
            </TABLE>
        >
        shape=box
        style="filled,bold"
        fillcolor="BLUE_ALT_FILL"
        color="BLUE"
        fontcolor="BLUE"
    ]

    // ── External services ────────────────────────────

    route53 [
        label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2">
                <TR><TD><B>Route 53</B></TD></TR>
                <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">cmdr.sh hosted zone</FONT></TD></TR>
            </TABLE>
        >
        shape=box
        style="filled,rounded"
        fillcolor="BG"
        color="BORDER"
    ]

    s3_assets [
        label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2">
                <TR><TD><B>S3</B></TD></TR>
                <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">Static assets · CSS/JS</FONT></TD></TR>
            </TABLE>
        >
        shape=box
        style="filled,rounded"
        fillcolor="BG"
        color="BORDER"
    ]

    cloudfront [
        label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2">
                <TR><TD><B>CloudFront</B></TD></TR>
                <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">CDN · assets.cmdr.sh</FONT></TD></TR>
            </TABLE>
        >
        shape=box
        style="filled,rounded"
        fillcolor="BG"
        color="BORDER"
    ]

    ecr [
        label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2">
                <TR><TD><B>ECR</B></TD></TR>
                <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">cmdr-app · code-api</FONT></TD></TR>
            </TABLE>
        >
        shape=box
        style="filled,rounded"
        fillcolor="BG"
        color="BORDER"
    ]

    gitlab_ci [
        label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2">
                <TR><TD><B>GitLab CI</B></TD></TR>
                <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">OIDC · deploy role</FONT></TD></TR>
            </TABLE>
        >
        shape=box
        style="filled,rounded"
        fillcolor="BG"
        color="BORDER"
    ]

    // ── cmdr VPC ──────────────────────────────────
    subgraph cluster_vpc_cmdr {
        label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1">
                <TR><TD><B><FONT COLOR="BLUE">cmdr VPC</FONT></B></TD></TR>
                <TR><TD><FONT POINT-SIZE="9" COLOR="MUTED">us-east-1 · 2 AZs</FONT></TD></TR>
            </TABLE>
        >
        style="dashed,filled,rounded"
        color="BLUE"
        fillcolor="CLUSTER_FILL"
        fontcolor="BLUE"

        _anchor_vpc_cmdr [shape=point style=invis width=0]

        alb [
            label=<
                <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2">
                    <TR><TD><B>ALB</B></TD></TR>
                    <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">Application Load Balancer</FONT></TD></TR>
                </TABLE>
            >
            shape=box
            style="filled,rounded"
            fillcolor="NODE_BLUE_FILL"
            color="BLUE"
        ]

        ecs_cluster [
            label=<
                <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2">
                    <TR><TD><B>ECS Cluster</B></TD></TR>
                    <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">Fargate</FONT></TD></TR>
                </TABLE>
            >
            shape=box
            style="filled,rounded"
            fillcolor="NODE_BLUE_FILL"
            color="BLUE"
        ]

        subgraph cluster_private_subnets {
            label=<
                <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1">
                    <TR><TD><B><FONT COLOR="BLUE_ALT">Private Subnets (1a, 1b)</FONT></B></TD></TR>
                    <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">Fargate tasks</FONT></TD></TR>
                </TABLE>
            >
            style="dashed,filled,rounded"
            color="BLUE_ALT"
            fillcolor="SUBNET_FILL"

            code_api [
                label=<
                    <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2">
                        <TR><TD><B>code-api</B></TD></TR>
                        <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">Fargate task · nsjail sandbox</FONT></TD></TR>
                    </TABLE>
                >
                shape=box
                style="filled,rounded"
                fillcolor="NODE_BLUE_FILL"
                color="BLUE"
            ]

            redis [
                label=<
                    <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2">
                        <TR><TD><B>Redis</B></TD></TR>
                        <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">Fargate task · EFS-backed</FONT></TD></TR>
                    </TABLE>
                >
                shape=cylinder
                style="filled"
                fillcolor="NODE_BLUE_FILL"
                color="BLUE"
            ]
        }

        subgraph cluster_public_subnets {
            label=<
                <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1">
                    <TR><TD><B><FONT COLOR="BLUE_ALT">Public Subnets (1a, 1b)</FONT></B></TD></TR>
                    <TR><TD><FONT POINT-SIZE="8" COLOR="MUTED">ALB · NAT Gateway</FONT></TD></TR>
                </TABLE>
            >
            style="dashed,filled,rounded"
            color="BLUE_ALT"
            fillcolor="SUBNET_FILL"
        }
    }

    // ── Edges ────────────────────────────────────────
    internet -> route53 [
        label="DNS lookup"
        style=dashed
        color="EDGE"
    ]
    internet -> alb [
        label="HTTPS :443"
        color="EDGE"
    ]
    route53 -> cloudfront [
        label="assets.cmdr.sh"
        style=dashed
        color="EDGE"
    ]
    cloudfront -> s3_assets [
        label="origin fetch"
        color="EDGE"
    ]
    alb -> fargate_app [
        label="HTTP"
        color="BLUE"
        fontcolor="BLUE"
    ]
    alb -> code_api [
        label="/api/code"
        color="BLUE"
        fontcolor="BLUE"
    ]
    fargate_app -> s3_assets [
        label="upload assets"
        style=dashed
        color="EDGE"
    ]
    fargate_app -> ecr [
        label="pull image"
        style=dashed
        color="EDGE"
    ]
    fargate_app -> nat_gateway [
        label="egress"
        style=dashed
        color="BLUE"
        fontcolor="BLUE"
    ]
    code_api -> redis [
        label="cache"
        color="BLUE"
        fontcolor="BLUE"
    ]
    code_api -> nat_gateway [
        label="egress"
        style=dashed
        color="BLUE"
        fontcolor="BLUE"
    ]
    nat_gateway -> internet [
        label="egress only"
        style=dashed
        color="BLUE"
        fontcolor="BLUE"
    ]
    gitlab_ci -> ecr [
        label="docker push"
        color="EDGE"
    ]
    gitlab_ci -> s3_assets [
        label="upload"
        color="EDGE"
    ]
    gitlab_ci -> fargate_app [
        label="force deploy"
        style=dashed
        color="EDGE"
    ]

}
